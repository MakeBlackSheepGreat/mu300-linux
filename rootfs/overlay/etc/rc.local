#!/bin/sh
# /etc/rc.local is the last thing /etc/init.d/done (S95done) runs at boot, and that hook is
# guarded by "[ -f /etc/rc.local ]". The overlay shipped no rc.local, so nothing placed here
# ever ran even though the rc.d link was always present.
echo "rc-local-ran $(date +%s) kernel=$(uname -r)" >> /root/rcmark
sync