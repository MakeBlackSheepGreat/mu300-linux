#!/bin/sh
# /etc/rc.local - runs last in OpenWrt's boot. The link is S95done -> /etc/init.d/done, whose
# hook is "[ -f /etc/rc.local ] && sh /etc/rc.local"; the overlay used to ship no rc.local at
# all, which is why rc.local was believed never to run even though the rc.d link was present.
#
# One marker line per boot. This is X1's acceptance criterion.
echo "rc-local-ran $(date +%s) kernel=$(uname -r)" >> /root/rcmark
sync

exit 0