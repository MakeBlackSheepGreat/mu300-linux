#!/bin/sh /etc/rc.common
# Bring sipa_eth0 (modem data interface) up once the CP has created it.
# START=99 keeps it after the modem loader has had a chance to run; respawn lets procd retry
# instead of losing the waiter, which is what happened with the rc.local subshell.
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /opt/mu300/bin/sipa-wait 300 2
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}