#!/bin/sh /etc/rc.common
# OpenWrt hotspot bring-up for the NX302J (SC2355 Marlin3 over SDIO).
#
# Why this exists instead of the stock OpenWrt path: this rootfs ships no
# wifi-scripts, so /sbin/wifi, /usr/share/hostapd and `ubus call
# network.wireless status` are all absent (measured on the device:
# `which wifi` is empty, `ubus list | grep network.wireless` returns nothing).
# UCI alone therefore cannot start an AP here. The upstream hotspot-start
# already knows how to do it (it switches wlan0 to __ap itself, points hostapd
# at br-lan and waits for both interfaces), so it is used unchanged apart from
# its three bash-only constructs, which had to go because this rootfs has no
# bash (`which bash` is empty).
#
# START=21 puts it after network (S20) so br-lan exists; hotspot-start waits for
# wlan0 and br-lan on its own, up to 60 s and 30 s respectively.

START=21
USE_PROCD=1
STOP=21
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	procd_open_instance
	procd_set_param command /opt/mu300/bin/hotspot-start
	# The AP must come back if hostapd ever exits; hotspot-start exec()s it, so
	# the instance is hostapd itself and a respawn re-runs the whole sequence.
	procd_set_param respawn 3600 1 0
	procd_set_param limits core="unlimited"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/opt/mu300/bin/hotspot-stop 2>/dev/null || true
}
